    given-names: "Masaki"
  - family-names: "Sasaki"
    given-names: "Nobuya"
repository-code: "https://github.com/masakiwatanabe-labani/FVB-reference-bias-RNAseq"
license: MIT
date-released: "2026-10-26"
keywords:
  - RNA-seq
  - reference bias
  - FVB mouse
  - personalised reference genome
  - g2gtools
  - WASP
  - featureCounts
  - SNP-mediated bias
preferred-citation:
